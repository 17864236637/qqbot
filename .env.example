# QQ 机器人配置示例 —— 复制为 .env 并填入你的真实值
# 获取地址：QQ 开放平台 https://bot.qq.com → 你的机器人应用 → 开发设置

# 机器人 appId
APP_ID=在此填入你的_appId

# 机器人 clientSecret
APP_SECRET=在此填入你的_clientSecret

# 目标群 openid（消息发到这个群）
# 获取方式：机器人需先加群；通过 QQ 开放平台「沙箱/正式环境」的群列表或
# 接收消息回调里的 group_openid 字段获得
GROUP_OPENID=在此填入目标群_openid

# 推送间隔（秒），默认 300（5 分钟）
INTERVAL_SEC=300

# 机器人展示名（仅用于日志与消息落款）
BOT_NAME=QQ监督员

# ===== 大脑后端 =====
# 服务器部署选方案 A（无需本地模型，不装 torch）；本机跑选方案 B。
# 方案 A：OpenAI 兼容 API —— 把下面四行的注释去掉并填值
#QQ_BRAIN_MODEL=api
#QQ_BRAIN_API_BASE=https://api.deepseek.com/v1
#QQ_BRAIN_API_KEY=sk-xxxxxxxxxxxxxxxx
#QQ_BRAIN_API_MODEL=deepseek-chat
# 各云 base / 模型名参考：
#   智谱 GLM       base=https://open.bigmodel.cn/api/paas/v4   model=glm-4-flash（免费）
#   硅基流动       base=https://api.siliconflow.cn/v1          model=Qwen/Qwen2.5-7B-Instruct（有免费额度）
#   GitHub Models  base=https://models.inference.ai.azure.com model=gpt-4o-mini
# 方案 B：本地模型（默认 1.5b；服务器上没模型文件会降级为兜底文案）
#QQ_BRAIN_MODEL=1.5b
