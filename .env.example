# QQ 机器人配置示例 —— 复制为 .env 并填入你的真实值
# 获取地址：QQ 开放平台 https://bot.qq.com → 你的机器人应用 → 开发设置

# 机器人 appId
APP_ID=在此填入你的_appId

# 机器人 clientSecret
APP_SECRET=在此填入你的_clientSecret

# 目标群 openid（消息发到这个群）
# 获取方式：机器人需先加群；通过 QQ 开放平台「沙箱/正式环境」的群列表或
# 接收消息回调里的 group_openid 字段获得
GROUP_OPENID=在此填入目标群_openid

# 推送间隔（秒），默认 300（5 分钟）
INTERVAL_SEC=300

# 机器人展示名（仅用于日志与消息落款）
BOT_NAME=QQ监督员
